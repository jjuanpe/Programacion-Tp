@startuml
' Copa Internacional de Clubes - diagrama de clases del dominio
' Se puede ver en https://www.plantuml.com/plantuml o con el plugin "PlantUML Integration" de IntelliJ.
hide empty members
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package model.people {
  abstract class Person {
    - name : String
    - birthDate : LocalDate
    - documentType : DocumentType
    - document : String
    + getAge(referenceDate : LocalDate) : int
    + {abstract} getRole() : String
  }
  class Player {
    - position : Position
  }
  class Goalkeeper
  class FieldPlayer
  class HeadCoach
  class Referee
  enum Position
  enum DocumentType
  Person <|-- Player
  Person <|-- HeadCoach
  Person <|-- Referee
  Player <|-- Goalkeeper
  Player <|-- FieldPlayer
}

package model.team {
  class Team {
    - name : String
    - ranking : int
  }
  class Country {
    - name : String
  }
}

package model.venue {
  class City
  class Stadium {
    - capacity : int
  }
}

package model.match {
  abstract class Match {
    - date : LocalDate
    - homeGoals : int
    - awayGoals : int
    - played : boolean
    + {abstract} getPhaseLabel() : String
    + {abstract} allowsPenaltyShootout() : boolean
    + hasPenaltyShootout() : boolean
    + getShootoutGoals(team : Team) : int
    + describeAggregate() : String
  }
  class GroupMatch
  class FirstLegMatch
  class SecondLegMatch {
    + getPointsForSecondLegHomeTeam() : int
    + getPointsForSecondLegAwayTeam() : int
    + getDecidingCriterion() : TieCriterion
    + describeAggregate() : String
  }
  enum TieCriterion {
    POINTS
    GOAL_DIFFERENCE
    PENALTY_SHOOTOUT
    + getLabel() : String
  }
  class FinalMatch
  class PlayerParticipation {
    - starter : boolean
    - minutesPlayed : int
  }
  Match <|-- GroupMatch
  Match <|-- FirstLegMatch
  Match <|-- SecondLegMatch
  Match <|-- FinalMatch
  SecondLegMatch --> "1" FirstLegMatch : firstLeg
  SecondLegMatch ..> TieCriterion
}

package model.event {
  abstract class Incidence {
    - minute : int
    + {abstract} getTypeLabel() : String
    + {abstract} getDetail() : String
    + getMinuteLabel() : String
    + isShootoutKick() : boolean
    + isScoredShootoutKickBy(team : Team) : boolean
  }
  class Goal {
    - ownGoal : boolean
    - penalty : boolean
  }
  class YellowCard
  class Expulsion
  class Change
  class PenaltyExecuted {
    + isShootoutKick() : boolean
    + isScoredShootoutKickBy(team : Team) : boolean
  }
  class PlayEvent
  Incidence <|-- Goal
  Incidence <|-- YellowCard
  Incidence <|-- Expulsion
  Incidence <|-- Change
  Incidence <|-- PenaltyExecuted
  Incidence <|-- PlayEvent
}

package model.competition {
  class Championship
  class Zone {
    - name : String
  }
  class StandingEntry
  class StandingsService
  class DrawService
  class FixtureService
}

package model.simulation {
  interface "MatchSimulationStrategy<T extends Match>" as MSS {
    + simulate(match, suspended, random) : MatchSimulationResult
  }
  class GroupMatchSimulationService
  class GroupStageSimulator
  class KnockoutStageSimulator
  class KnockoutTieTask
  class KnockoutTieReport {
    - decidingCriteria : String
  }
  class MatchSimulationReport {
    - standingsBefore : List<StandingEntry>
    - standingsAfter : List<StandingEntry>
  }
  class TeamStrengthCalculator
  MSS <|.. GroupMatchSimulationService
  GroupMatchSimulationService --> TeamStrengthCalculator
  GroupStageSimulator --> MSS
  KnockoutStageSimulator --> KnockoutTieTask
  KnockoutTieTask ..> KnockoutTieReport
  KnockoutTieTask ..> TieCriterion
  GroupStageSimulator ..> MatchSimulationReport
  MatchSimulationReport --> "*" StandingEntry
}

Team "1" *-- "18" Player : plantel
Team "1" --> "1" HeadCoach
Team --> Country
Team --> Stadium : local
HeadCoach --> Country
Referee --> Country
City --> Country
City "1" o-- "*" Stadium
Stadium --> City

Match --> "2" Team : local / visitante
Match --> Stadium
Match --> Referee
Match "1" *-- "*" Incidence
Match "1" *-- "*" PlayerParticipation
PlayerParticipation --> Player

Championship "1" *-- "4" Zone
Championship --> "*" Referee
Championship --> "*" Stadium
Zone "1" o-- "4" Team
Zone "1" *-- "6" GroupMatch
StandingsService ..> StandingEntry
StandingEntry --> Team

package dao {
  class DBManager {
    + {static} getConnection() : Connection
  }
  class CityDao {
    + insertCity(id, name, country)
    + updateCity(id, name, country)
    + deleteCity(id)
    + getAllCities() : List<City>
  }
  class StadiumDAO {
    + insertStadium(id, name, city, capacity)
    + updateStadium(originalId, newId, name, city, capacity)
    + deleteStadium(id)
    + getAllStadiums() : List<Stadium>
  }
  CityDao ..> DBManager
  StadiumDAO ..> DBManager
  StadiumDAO --> CityDao
}
CityDao ..> City
StadiumDAO ..> Stadium

package controller {
  class TournamentSession {
    + addCity() / updateCity() / deleteCity()
    + addStadium() / updateStadium() / deleteStadium()
    + getGroupStageReports() : List<MatchSimulationReport>
  }
}
TournamentSession --> Championship
TournamentSession --> "*" MatchSimulationReport
TournamentSession ..> CityDao
TournamentSession ..> StadiumDAO
TournamentSession ..> GroupStageSimulator
TournamentSession ..> KnockoutStageSimulator
@enduml
